{
  "name": "titanbot-custom",
  "version": "1.1.1",
  "description": "Modular Ultimate Community Bot by Touchpoint Support",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "node dashboard/server/index.js",
    "build": "vite build dashboard/client --config dashboard/vite.config.js",
    "start": "NODE_ENV=production node dashboard/server/index.js",
    "bot": "node src/app.js",
    "test": "node --test tests/**/*.test.js",
    "migrate": "node scripts/migrate.js apply",
    "migrate:check": "node scripts/migrate.js check",
    "migrate:status": "node scripts/migrate.js status",
    "backup:db": "node scripts/backup.js",
    "restore:db": "node scripts/restore.js",
    "backup:drill": "node scripts/restore-drill.js"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@discordjs/voice": "^0.19.2",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "libsodium-wrappers": "^0.7.15",
    "node-cron": "^4.2.1",
    "opusscript": "^0.0.8",
    "pg": "^8.22.0",
    "prism-media": "^1.3.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "youtube-dl-exec": "^3.1.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.3",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
